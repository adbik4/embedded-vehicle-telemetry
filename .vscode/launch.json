{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        },

        {
            "name": "Cortex-debug + STLINK",
            "cwd": "${workspaceFolder}",
            "executable": "./build/Debug/embedded-vehicle-telemetry.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "servertype": "stlink",
            "serverArgs":
            [
            "-s",
            "-m", "0",
            "-k",
            "--frequency", "21000",
            ],
            "serverpath": "B:/NARZEDZIA/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.stlink-gdb-server.win32_2.2.500.202604010938/tools/bin/ST-LINK_gdbserver.exe",
            "armToolchainPath": "B:/NARZEDZIA/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.win32_1.0.100.202602081740/tools/bin",
            "stm32cubeprogrammer": "B:/NARZEDZIA/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.cubeprogrammer.win32_2.2.500.202603051304/tools/bin",
            "device":"STM32U3C5ZIT6Q",
            "svdFile": "${workspaceFolder}/STM32U3C5.svd"
        }
    ]
}